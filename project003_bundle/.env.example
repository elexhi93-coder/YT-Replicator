# ─────────────────────────────────────────────────────
# project003 — Environment Variables
# Copy this file to .env and fill in your values.
# .env is git-ignored. Do not commit secrets.
# ─────────────────────────────────────────────────────

# ── Storage ──────────────────────────────────────────
# Path on the host where downloaded videos are stored.
# Bind-mounted into watcher, processor (RW) and n8n (RO).
# Example for an external drive:  DOWNLOADS_PATH=E:/project003/downloads
DOWNLOADS_PATH=./downloads

# ── Timezone ─────────────────────────────────────────
TIMEZONE=Europe/Paris

# ── Watcher settings ─────────────────────────────────
# Minutes between MONITOR-mode polls of each YouTube channel
CHECK_INTERVAL=15

# Global daily download limit per channel (overridden per-channel in DB)
DAILY_UPLOAD_LIMIT=10

# Logging: INFO | DEBUG | WARNING
LOG_LEVEL=INFO

# Global fallback webhook URL — uses Docker internal DNS
N8N_WEBHOOK_URL=http://n8n:5678/webhook/idm-yt-download

# ── Processor settings ───────────────────────────────
# Seconds between DB polls for new jobs
PROCESSOR_POLL_INTERVAL=5

# true = use NVENC GPU encoding; false = use libx264 (CPU)
# Requires NVIDIA Container Toolkit + uncommenting `deploy:` block in docker-compose.yml
USE_GPU=false

# ── n8n settings ─────────────────────────────────────
# NOTE: All API keys / OAuth credentials live INSIDE n8n (encrypted credential store).
# Only infrastructure-level config goes here.

# Encryption key for the n8n credential store. CHANGE THIS to a long random string.
# Used the first time n8n starts; do not change after credentials are stored.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Optional: restrict access to n8n UI (leave blank for no auth)
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
# ─────────────────────────────────────────────────────
# project003 — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────

# ── Watcher settings ─────────────────────────────────

# Max uploads per channel per day (YouTube free tier: 6, with quota increase: 10-15)
DAILY_UPLOAD_LIMIT=10

# How often to poll each channel for new videos in MONITOR mode (minutes)
CHECK_INTERVAL=15

# Delete downloaded video files after this many hours (0 = never)
CLEANUP_TTL_HOURS=24

# Logging level: INFO or DEBUG (DEBUG shows full yt-dlp output)
LOG_LEVEL=INFO

# ── n8n webhook ───────────────────────────────────────

# Global fallback webhook URL (used if no per-channel URL is set in n8n_webhook_config.json)
# Uses Docker internal DNS — do NOT change n8n to localhost
N8N_WEBHOOK_URL=http://n8n:5678/webhook/idm-yt-download

# ── n8n settings (used by docker-compose) ────────────

# n8n encryption key — CHANGE THIS to a long random string
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Optional: restrict access to n8n UI (leave blank for no auth)
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
